---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { ArrowLeft, ArrowRight, ChevronRight, ExternalLink, FileText, Info } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BLOCS, CONTEXTES } from '@/config/referentiel';
import { TOUS_SAVOIRS } from '@/config/savoirs';
import { EXPERIENCES } from '@/config/parcours';
import { TEINTE, iconeFiche } from '@/config/visuels';
import { url } from '@/utils/url';

export const getStaticPaths = (async () => {
  const toutes = (await getCollection('realisations', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.ordre - b.data.ordre,
  );
  return toutes.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, precedente: toutes[i - 1], suivante: toutes[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { entry, precedente, suivante } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const Icone = iconeFiche(entry.id);
const teinte = TEINTE[d.contexte];

// Compétences du référentiel mobilisées, regroupées par bloc
const parBloc = BLOCS.map((b) => ({
  titre: b.titre.split(' — ')[0],
  items: b.competences.filter((c) => (d.competences as string[]).includes(c.id)),
})).filter((b) => b.items.length > 0);

// Savoirs du bloc 1 pour lesquels cette fiche sert de preuve (suivi pédagogique)
const savoirs = TOUS_SAVOIRS.filter((s) => s.valide && s.fiches?.includes(entry.id));

// Documents associés : documentation du TP, rapport de stage
const rapport = EXPERIENCES.find((e) => e.fiche === entry.id)?.rapport;
const sommaire = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={d.title} description={d.description} type="article">
  <header class="hero">
    <div class="container-page py-10 md:py-14">
      <nav aria-label="Fil d'Ariane" class="muted flex items-center gap-1.5 text-sm">
        <a href={url('realisations/')} class="hover:text-[var(--brand-2)]">Réalisations</a>
        <ChevronRight class="size-3.5" aria-hidden="true" />
        <span aria-current="page">{d.court}</span>
      </nav>
      <div class:list={['mt-6 flex flex-col gap-5 sm:flex-row sm:items-start', teinte]}>
        <span class="tile tile-lg"><Icone class="size-8" aria-hidden="true" /></span>
        <div>
          <span class="tag">{CONTEXTES[d.contexte]}</span>
          <h1 class="mt-3 max-w-4xl text-[clamp(1.6rem,3.6vw,2.4rem)] leading-tight font-extrabold tracking-tight">{d.title}</h1>
          <p class="lead mt-3 max-w-3xl">{d.description}</p>
        </div>
      </div>
    </div>
  </header>

  <div class="container-page grid gap-8 py-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <!-- Colonne latérale : identité de la fiche, compétences, preuves, sommaire -->
    <aside class="space-y-4 lg:order-2">
      <div class="card">
        <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--brand-2)]">Fiche d'identité</h2>
        <dl class="mt-3 space-y-3 text-[0.93rem]">
          <div><dt class="muted text-xs font-semibold uppercase">Cadre</dt><dd>{d.cadre}</dd></div>
          <div><dt class="muted text-xs font-semibold uppercase">Période</dt><dd>{d.periode}</dd></div>
          <div><dt class="muted text-xs font-semibold uppercase">Type</dt><dd>{CONTEXTES[d.contexte]}</dd></div>
          <div>
            <dt class="muted text-xs font-semibold uppercase">Outils</dt>
            <dd class="mt-1.5 flex flex-wrap gap-1.5">{d.outils.map((o) => <span class="chip-tool">{o}</span>)}</dd>
          </div>
        </dl>
      </div>

      <div class="card">
        <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--brand-2)]">Compétences mobilisées</h2>
        <div class="mt-3 space-y-3">
          {
            parBloc.map((b) => (
              <div>
                <p class="muted text-xs font-semibold uppercase">{b.titre}</p>
                <ul class="mt-1.5 space-y-1.5 text-[0.9rem]">
                  {b.items.map((c) => (
                    <li>
                      <a href={url(`competences/#${c.id}`)} class="hover:text-[var(--brand-2)]">{c.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          {
            savoirs.length > 0 && (
              <div>
                <p class="muted text-xs font-semibold uppercase">Savoirs du bloc 1</p>
                <ul class="mt-1.5 flex flex-wrap gap-1.5">
                  {savoirs.map((s) => (
                    <li>
                      <a href={url(`competences/#${s.code}`)} class="pill" title={s.titre}>
                        <strong>{s.code}</strong> {s.titre}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </div>

      {
        (d.documentation || rapport) && (
          <div class="card">
            <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--brand-2)]">Documents</h2>
            <div class="mt-3 flex flex-col gap-2">
              {d.documentation && (
                <a href={d.documentation} rel="noopener" class="btn btn-primary justify-center">
                  Documentation détaillée du TP <ExternalLink class="size-4" aria-hidden="true" />
                </a>
              )}
              {rapport && (
                <a href={url(rapport)} class="btn btn-ghost justify-center">
                  <FileText class="size-4" aria-hidden="true" /> Rapport de stage (PDF)
                </a>
              )}
            </div>
          </div>
        )
      }

      {
        sommaire.length > 2 && (
          <nav aria-label="Sommaire de la fiche" class="card hidden lg:sticky lg:top-24 lg:block">
            <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--brand-2)]">Sommaire</h2>
            <ol class="mt-3 space-y-1.5 border-l-2 border-[var(--line)] text-[0.9rem]">
              {sommaire.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="muted -ml-0.5 block border-l-2 border-transparent pl-3 hover:border-[var(--brand-2)] hover:text-[var(--brand-2)]">
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </aside>

    <!-- Contenu de la fiche -->
    <div class="min-w-0 lg:order-1">
      {
        d.confidentialite && (
          <p class="notice mb-8 flex gap-2.5">
            <Info class="mt-0.5 size-4 shrink-0" aria-hidden="true" />
            <span>{d.confidentialite}</span>
          </p>
        )
      }
      <article class="prose-tech">
        <Content />
      </article>

      <nav aria-label="Autres réalisations" class="mt-14 grid gap-3 border-t border-[var(--line)] pt-8 sm:grid-cols-2">
        {
          precedente ? (
            <a href={url(`realisations/${precedente.id}/`)} class="card card-link">
              <span class="muted inline-flex items-center gap-1.5 text-xs font-semibold uppercase"><ArrowLeft class="size-3.5" aria-hidden="true" /> Réalisation précédente</span>
              <span class="mt-1.5 block font-semibold">{precedente.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          suivante && (
            <a href={url(`realisations/${suivante.id}/`)} class="card card-link sm:text-right">
              <span class="muted inline-flex items-center gap-1.5 text-xs font-semibold uppercase">Réalisation suivante <ArrowRight class="size-3.5" aria-hidden="true" /></span>
              <span class="mt-1.5 block font-semibold">{suivante.data.title}</span>
            </a>
          )
        }
      </nav>
    </div>
  </div>
</BaseLayout>
