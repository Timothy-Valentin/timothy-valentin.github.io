---
import { getCollection } from 'astro:content';
import { ArrowRight, ListChecks } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import RealisationCard from '@/components/RealisationCard.astro';
import Filtres from '@/components/Filtres.astro';
import { CONTEXTES, type Contexte } from '@/config/referentiel';
import { url } from '@/utils/url';

const realisations = (await getCollection('realisations', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);

const compte = Object.fromEntries(
  (Object.keys(CONTEXTES) as Contexte[]).map((c) => [c, realisations.filter((r) => r.data.contexte === c).length]),
) as Record<Contexte, number>;
---

<BaseLayout
  title="Réalisations"
  description="Réalisations de Timothy Valentin en BTS SIO SISR : stage au Ministère de la Justice, réseau d'entreprise complet, centralisation des journaux, GLPI, Packet Tracer, Proxmox, Root-Me."
>
  <PageHeader
    eyebrow="Réalisations"
    title="Ce que j'ai réalisé"
    intro="En stage, en formation et en autonomie. Chaque fiche suit le même plan : contexte, objectifs, démarche, résultat, bilan, et les compétences du référentiel mobilisées."
  />

  <div class="container-page py-10">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <Filtres cible="liste-realisations" compte={compte} />
      <a href={url('competences/')} class="link inline-flex items-center gap-1.5 text-sm">
        <ListChecks class="size-4" aria-hidden="true" /> Voir le tableau de synthèse des compétences <ArrowRight class="size-4" aria-hidden="true" />
      </a>
    </div>

    <h2 class="sr-only">Liste des réalisations</h2>
    <ul id="liste-realisations" class="mt-7 grid gap-4.5 sm:grid-cols-2 lg:grid-cols-3">
      {realisations.map((r) => <li><RealisationCard r={r} /></li>)}
    </ul>
  </div>
</BaseLayout>
