---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import EntryCard from '@/components/EntryCard.astro';
import { url } from '@/utils/url';

const fiches = (await getCollection('homelab', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);

const topologie = `flowchart LR
  admin["Poste d'administration<br/>PuTTY · navigateur web"]
  subgraph pve["Serveur Proxmox VE"]
    deb["VM Debian"]
    ubu["VM Ubuntu"]
    kali["VM Kali Linux<br/>environnement de test"]
  end
  subgraph vbox["Ordinateur personnel — VirtualBox"]
    vm["VM de test ponctuelles"]
  end
  admin -- "interface web (HTTPS 8006)" --> pve
  admin -- "SSH" --> deb
  admin -- "SSH" --> ubu`;
---

<BaseLayout
  title="Homelab"
  description="Homelab de Timothy Valentin : serveur Proxmox VE monté et installé par mes soins, machines virtuelles Debian, Ubuntu et Kali Linux, VirtualBox et administration avec PuTTY."
>
  <div class="container-page py-10">
    <PageHeader
      eyebrow="Environnement personnel"
      title="Homelab"
      intro="L'environnement que j'utilise pour pratiquer en dehors de la formation : un serveur Proxmox VE que j'ai monté et installé moi-même, complété par VirtualBox sur mon ordinateur personnel."
    />

    <section class="mt-10" aria-labelledby="vue-ensemble">
      <h2 id="vue-ensemble" class="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-50">
        Vue d'ensemble
      </h2>
      <pre class="mermaid mt-4" data-pagefind-ignore>{topologie}</pre>
    </section>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {
        fiches.map((f) => (
          <EntryCard
            href={url(`homelab/${f.id}/`)}
            title={f.data.title}
            description={f.data.description}
            date={f.data.date}
            label="Homelab"
            tags={f.data.tags}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
