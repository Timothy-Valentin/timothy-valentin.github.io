---
import { Download, ExternalLink, RefreshCw } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { SOURCES } from '@/config/veille-sources';
import { collecter, surLeSujet, type Article } from '@/utils/flux';
import { url } from '@/utils/url';

const { articles, enEchec, date } = await collecter();

const sujet = articles.filter(surLeSujet).slice(0, 12);
const officiel = articles.filter((a) => a.source.categorie === 'officiel').slice(0, 8);
const presse = articles.filter((a) => a.source.categorie !== 'officiel' && !sujet.includes(a)).slice(0, 8);

const jour = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/Paris' });
const maj = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Paris' }).format(date);

const sections: { id: string; titre: string; intro: string; items: Article[] }[] = [
  {
    id: 'sujet',
    titre: 'Sur mon sujet : passkeys et authentification',
    intro: 'Articles de toutes mes sources contenant un mot-clé de ma veille (passkey, FIDO, WebAuthn, mot de passe, MFA, hameçonnage…).',
    items: sujet,
  },
  {
    id: 'officiel',
    titre: 'Sources officielles',
    intro: 'Dernières publications du CERT-FR, de l’ANSSI et de la CNIL.',
    items: officiel,
  },
  {
    id: 'presse',
    titre: 'Actualité de la cybersécurité',
    intro: 'Presse spécialisée et blogs sécurité des éditeurs.',
    items: presse,
  },
];
---

<BaseLayout
  title="Fil d'actualités de veille"
  description="Fil de veille de Timothy Valentin mis à jour automatiquement chaque jour à partir de sources officielles (CERT-FR, ANSSI, CNIL) et spécialisées, filtré sur les passkeys et l'authentification."
>
  <div class="container-page py-10">
    <a href={url('veille/')} class="text-sm text-slate-500 hover:text-brand-700 dark:hover:text-brand-300">← Retour à la veille</a>
    <div class="mt-6">
      <PageHeader
        eyebrow="Veille technologique · outil de curation"
        title="Fil d'actualités"
        intro="Ce fil rassemble automatiquement les dernières publications de mes sources de veille, et met en avant celles qui concernent mon sujet. La lecture, la vérification et la synthèse restent un travail personnel, restitué dans ma fiche sur les passkeys."
      >
        <p class="mt-4 flex items-center gap-2 text-sm text-slate-500">
          <RefreshCw class="size-4" aria-hidden="true" /> Mis à jour automatiquement chaque jour · dernière collecte le {maj}
        </p>
      </PageHeader>
    </div>

    {
      articles.length === 0 ? (
        <p class="mt-10 card text-sm text-slate-600 dark:text-slate-400">
          Les sources n'ont pas pu être consultées lors de la dernière mise à jour. Le fil sera actualisé à la prochaine collecte.
        </p>
      ) : (
        sections.map((s) => (
          <section class="mt-12" aria-labelledby={s.id}>
            <h2 id={s.id} class="h2">{s.titre}</h2>
            <p class="mt-1 text-sm text-slate-500">{s.intro}</p>
            {s.items.length === 0 ? (
              <p class="mt-4 text-sm text-slate-500 italic">Aucune publication récente dans cette catégorie.</p>
            ) : (
              <ul class="mt-4 divide-y divide-slate-200 rounded-lg border border-slate-200 dark:divide-slate-800 dark:border-slate-800">
                {s.items.map((a) => (
                  <li>
                    <a href={a.lien} rel="noopener" class="group flex items-start gap-3 px-4 py-3 hover:bg-slate-50 dark:hover:bg-slate-900">
                      <span class="min-w-0 flex-1">
                        <span class="block font-medium text-slate-900 group-hover:text-brand-700 dark:text-slate-100 dark:group-hover:text-brand-300">
                          {a.titre}
                        </span>
                        <span class="mt-0.5 block text-xs text-slate-500">
                          {a.source.nom} · <time datetime={a.date.toISOString()}>{jour.format(a.date)}</time>
                        </span>
                      </span>
                      <ExternalLink class="mt-1 size-4 shrink-0 text-slate-400" aria-hidden="true" />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      )
    }

    <section class="mt-12 card" aria-labelledby="sources">
      <h2 id="sources" class="font-semibold text-slate-900 dark:text-slate-100">Sources suivies</h2>
      <ul class="mt-3 grid gap-x-6 gap-y-1.5 text-sm sm:grid-cols-2">
        {
          SOURCES.map((s) => (
            <li class="flex items-center gap-2">
              <span
                class:list={[
                  'size-2 shrink-0 rounded-full',
                  !s.auto ? 'bg-slate-300 dark:bg-slate-600' : enEchec.includes(s) ? 'bg-amber-500' : 'bg-emerald-600',
                ]}
                aria-hidden="true"
              />
              <a href={s.site} rel="noopener" class="link">{s.nom}</a>
              {!s.auto && <span class="text-xs text-slate-500">(suivie dans Inoreader)</span>}
              {enEchec.includes(s) && <span class="text-xs text-amber-700 dark:text-amber-400">(indisponible lors de la collecte)</span>}
            </li>
          ))
        }
      </ul>
      <a href={url('veille/abonnements-veille.opml')} download class="btn btn-ghost mt-5">
        <Download class="size-4" aria-hidden="true" /> Liste des abonnements (OPML, importable dans un agrégateur RSS)
      </a>
    </section>
  </div>
</BaseLayout>
