---
import { getCollection } from 'astro:content';
import { ArrowRight, BookOpen, Download, CircleQuestionMark, Newspaper, Rss } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { formatDate, url } from '@/utils/url';

const fiches = (await getCollection('veille', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
---

<BaseLayout
  title="Veille technologique"
  description="Veille technologique de Timothy Valentin : les passkeys (clés d'accès FIDO2) qui remplacent les mots de passe, et la méthode de veille suivie (flux RSS, ANSSI, CNIL, CERT-FR)."
>
  <PageHeader
    eyebrow="Veille technologique"
    title="Les passkeys, vers la fin des mots de passe"
    intro="Mots de passe faibles, réutilisés, hameçonnés : les passkeys proposent de les remplacer par une paire de clés cryptographiques, déverrouillée par une empreinte ou un code PIN."
  />

  <div class="container-page py-10">
    <section class="card shadowed flex gap-4" aria-labelledby="problematique">
      <span class="tile"><CircleQuestionMark class="size-6" aria-hidden="true" /></span>
      <div>
        <h2 id="problematique" class="font-bold">Problématique</h2>
        <p class="muted mt-1.5 text-[1.02rem]">
          Les passkeys peuvent-elles remplacer les mots de passe, pour le grand public comme en entreprise ? Et que
          changent-elles pour la sécurité des comptes et pour le travail d'un administrateur systèmes et réseaux ?
        </p>
      </div>
    </section>

    <section class="mt-8 grid gap-4.5 md:grid-cols-2" aria-label="Fiches de veille">
      {
        fiches.map((f) => {
          const synthese = f.data.type === 'synthese';
          const Icone = synthese ? BookOpen : Rss;
          return (
            <a href={url(`veille/${f.id}/`)} class:list={['card card-link flex flex-col', synthese && 'panel-brand']}>
              <div class="flex items-center justify-between gap-3">
                <Icone class="size-7" aria-hidden="true" />
                <span class:list={['text-xs', synthese ? 'muted' : 'muted']}>
                  Mise à jour le <time datetime={f.data.miseAJour.toISOString()}>{formatDate(f.data.miseAJour)}</time>
                </span>
              </div>
              <p class="mt-4 text-xs font-bold tracking-wide uppercase opacity-80">{synthese ? 'Fiche de synthèse' : 'Méthode de veille'}</p>
              <h2 class="mt-1 text-xl font-bold">{f.data.title}</h2>
              <p class="muted mt-2 flex-1">{f.data.description}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 font-semibold">Lire la fiche <ArrowRight class="size-4" aria-hidden="true" /></span>
            </a>
          );
        })
      }
    </section>

    <section class="mt-4.5 grid gap-4.5 md:grid-cols-[1.3fr_1fr]" aria-label="Outils de veille">
      <a href={url('veille/actualites/')} class="card card-link flex gap-4">
        <span class="tile"><Newspaper class="size-6" aria-hidden="true" /></span>
        <span class="min-w-0">
          <span class="live">Mis à jour chaque jour</span>
          <span class="mt-2 block text-lg font-bold">Fil d'actualités de ma veille</span>
          <span class="muted mt-1 block">
            Les dernières publications de mes sources (CERT-FR, ANSSI, CNIL, presse spécialisée), collectées
            automatiquement et filtrées sur les passkeys et l'authentification.
          </span>
        </span>
      </a>
      <div class="card flex flex-col">
        <span class="tile"><Download class="size-6" aria-hidden="true" /></span>
        <p class="mt-4 text-lg font-bold">Mes abonnements</p>
        <p class="muted mt-1 flex-1">La liste de mes sources au format OPML, importable dans un agrégateur RSS comme Inoreader.</p>
        <a href={url('veille/abonnements-veille.opml')} download class="link mt-4 inline-flex items-center gap-1.5">
          Télécharger la liste <Download class="size-4" aria-hidden="true" />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
