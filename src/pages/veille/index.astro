---
import { getCollection } from 'astro:content';
import { BookOpen, Rss } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { formatDate, url } from '@/utils/url';

const fiches = (await getCollection('veille', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
---

<BaseLayout
  title="Veille technologique"
  description="Veille technologique et réglementaire de Timothy Valentin : l'architecture Zero Trust (NIST SP 800-207), la directive NIS 2, et la méthode de veille suivie (flux RSS, ANSSI, CERT-FR)."
>
  <div class="container-page py-10">
    <PageHeader
      eyebrow="Veille technologique et réglementaire"
      title="L'architecture Zero Trust"
      intro="Du modèle périmétrique au principe « ne jamais faire confiance, toujours vérifier » : comment les réseaux des entreprises et des administrations évoluent, et pourquoi la directive NIS 2 accélère ce mouvement."
    />

    <section class="mt-10 rounded-lg border-l-4 border-brand-700 bg-slate-50 p-5 dark:border-brand-300 dark:bg-slate-900" aria-labelledby="problematique">
      <h2 id="problematique" class="text-sm font-semibold text-brand-800 dark:text-brand-300">Problématique</h2>
      <p class="mt-2 text-slate-700 dark:text-slate-300">
        Avec le télétravail, le cloud et les attaques qui ciblent les administrations, le modèle du
        « château fort » suffit-il encore ? Et comment un administrateur systèmes et réseaux peut-il
        amorcer une démarche Zero Trust sur une infrastructure existante ?
      </p>
    </section>

    <section class="mt-8 grid gap-4 md:grid-cols-2" aria-label="Fiches de veille">
      {
        fiches.map((f) => {
          const Icon = f.data.type === 'synthese' ? BookOpen : Rss;
          return (
            <a href={url(`veille/${f.id}/`)} class="card card-link group flex flex-col">
              <div class="flex items-center justify-between text-xs text-slate-500">
                <span class="badge badge-accent">
                  {f.data.type === 'synthese' ? 'Fiche de synthèse' : 'Méthode de veille'}
                </span>
                <span>
                  Mise à jour le <time datetime={f.data.miseAJour.toISOString()}>{formatDate(f.data.miseAJour)}</time>
                </span>
              </div>
              <Icon class="mt-4 size-5 text-brand-700 dark:text-brand-300" aria-hidden="true" />
              <h2 class="mt-2 font-semibold text-slate-900 group-hover:text-brand-700 dark:text-slate-100 dark:group-hover:text-brand-300">
                {f.data.title}
              </h2>
              <p class="mt-2 flex-1 text-sm text-slate-600 dark:text-slate-400">{f.data.description}</p>
            </a>
          );
        })
      }
    </section>
  </div>
</BaseLayout>
