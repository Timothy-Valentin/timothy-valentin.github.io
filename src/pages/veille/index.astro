---
import { getCollection } from 'astro:content';
import { BookOpen, Rss } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { formatDate, url } from '@/utils/url';

const fiches = (await getCollection('veille', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
---

<BaseLayout
  title="Veille technologique"
  description="Veille technologique de Timothy Valentin : les passkeys (clés d'accès FIDO2) qui remplacent les mots de passe, et la méthode de veille suivie (flux RSS, ANSSI, CNIL, CERT-FR)."
>
  <div class="container-page py-10">
    <PageHeader
      eyebrow="Veille technologique"
      title="Les passkeys, vers la fin des mots de passe"
      intro="Mots de passe faibles, réutilisés, hameçonnés : les passkeys proposent de les remplacer par une paire de clés cryptographiques, déverrouillée par une empreinte ou un code PIN."
    />

    <section class="mt-10 rounded-lg border-l-4 border-brand-700 bg-slate-50 p-5 dark:border-brand-300 dark:bg-slate-900" aria-labelledby="problematique">
      <h2 id="problematique" class="text-sm font-semibold text-brand-800 dark:text-brand-300">Problématique</h2>
      <p class="mt-2 text-slate-700 dark:text-slate-300">
        Les passkeys peuvent-elles remplacer les mots de passe, pour le grand public comme en
        entreprise ? Et que changent-elles pour la sécurité des comptes et pour le travail d'un
        administrateur systèmes et réseaux ?
      </p>
    </section>

    <section class="mt-8 grid gap-4 md:grid-cols-2" aria-label="Fiches de veille">
      {
        fiches.map((f) => {
          const Icon = f.data.type === 'synthese' ? BookOpen : Rss;
          return (
            <a href={url(`veille/${f.id}/`)} class="card card-link group flex flex-col">
              <div class="flex items-center justify-between text-xs text-slate-500">
                <span class="badge badge-accent">
                  {f.data.type === 'synthese' ? 'Fiche de synthèse' : 'Méthode de veille'}
                </span>
                <span>
                  Mise à jour le <time datetime={f.data.miseAJour.toISOString()}>{formatDate(f.data.miseAJour)}</time>
                </span>
              </div>
              <Icon class="mt-4 size-5 text-brand-700 dark:text-brand-300" aria-hidden="true" />
              <h2 class="mt-2 font-semibold text-slate-900 group-hover:text-brand-700 dark:text-slate-100 dark:group-hover:text-brand-300">
                {f.data.title}
              </h2>
              <p class="mt-2 flex-1 text-sm text-slate-600 dark:text-slate-400">{f.data.description}</p>
            </a>
          );
        })
      }
    </section>
  </div>
</BaseLayout>
