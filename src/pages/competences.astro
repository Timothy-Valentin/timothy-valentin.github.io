---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { BLOCS, CONTEXTES } from '@/config/referentiel';
import { url } from '@/utils/url';

const realisations = (await getCollection('realisations', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);

const preuves = (id: string) => realisations.filter((r) => (r.data.competences as string[]).includes(id));
---

<BaseLayout
  title="Tableau de synthèse des compétences"
  description="Tableau de synthèse des compétences du référentiel BTS SIO SISR (blocs 1, 2 et 3) mobilisées dans les réalisations de Timothy Valentin."
>
  <div class="container-page py-10">
    <PageHeader
      eyebrow="Référentiel BTS SIO — option SISR"
      title="Tableau de synthèse des compétences"
      intro="Pour chaque compétence du référentiel, les réalisations qui la démontrent. Cliquez sur une réalisation pour ouvrir sa fiche. Ce tableau est tenu à jour au fil de la formation."
    />

    {
      BLOCS.map((bloc) => (
        <section class="mt-12" aria-labelledby={bloc.id}>
          <h2 id={bloc.id} class="text-lg font-bold tracking-tight text-slate-900 dark:text-slate-50">
            {bloc.titre}
          </h2>
          <div class="mt-4 overflow-hidden rounded-lg border border-slate-200 dark:border-slate-800">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-50 text-xs text-slate-500 uppercase dark:bg-slate-900">
                <tr>
                  <th class="w-1/2 px-4 py-2.5 font-medium">Compétence</th>
                  <th class="px-4 py-2.5 font-medium">Réalisations</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                {bloc.competences.map((c) => {
                  const liste = preuves(c.id);
                  return (
                    <tr id={c.id} class="align-top target:bg-brand-50 dark:target:bg-brand-400/10">
                      <td class="px-4 py-3 text-slate-800 dark:text-slate-200">{c.label}</td>
                      <td class="px-4 py-3">
                        {liste.length > 0 ? (
                          <ul class="flex flex-wrap gap-1.5">
                            {liste.map((r) => (
                              <li>
                                <a
                                  href={url(`realisations/${r.id}/`)}
                                  class="badge hover:border-brand-500 hover:text-brand-700 dark:hover:text-brand-300"
                                  title={`${CONTEXTES[r.data.contexte]} — ${r.data.title}`}
                                >
                                  {r.data.court}
                                </a>
                              </li>
                            ))}
                          </ul>
                        ) : (
                          <span class="text-xs text-slate-400 italic">À couvrir en 2e année</span>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      ))
    }

    <section class="mt-12 card" aria-labelledby="legende">
      <h2 id="legende" class="font-semibold text-slate-900 dark:text-slate-100">Réalisations référencées</h2>
      <ul class="mt-3 space-y-1.5 text-sm">
        {
          realisations.map((r) => (
            <li>
              <span class="badge mr-2">{r.data.court}</span>
              <a href={url(`realisations/${r.id}/`)} class="link">
                {r.data.title}
              </a>
              <span class="text-slate-500"> — {CONTEXTES[r.data.contexte]}, {r.data.periode}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
