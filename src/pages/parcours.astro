---
import { ArrowRight, Briefcase, Download, ExternalLink, FileText, GraduationCap, Search } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { SITE } from '@/config/site';
import { ENTRAINEMENT, EXPERIENCES, FORMATION, type Etape } from '@/config/parcours';
import { ICONES_DIVERS } from '@/config/visuels';
import { url } from '@/utils/url';

const colonnes: { id: string; titre: string; icone: typeof GraduationCap; etapes: Etape[] }[] = [
  { id: 'formation', titre: 'Formation', icone: GraduationCap, etapes: FORMATION },
  { id: 'experience', titre: 'Expérience', icone: Briefcase, etapes: EXPERIENCES },
];
---

<BaseLayout
  title="Parcours"
  description="Parcours de Timothy Valentin : BTS SIO SISR au lycée Henri Matisse de Cugnaux après une première carrière dans les métiers de la forme, stage au Ministère de la Justice."
>
  <PageHeader
    eyebrow="Parcours"
    title="Une reconversion vers l'informatique"
    intro="Après un DEUST puis une licence Métiers de la forme, et une activité de coach sportif puis de préparateur physique, je me suis orienté vers l'administration des systèmes et des réseaux. Ma première carrière m'a appris à analyser un besoin, à organiser une progression et à accompagner des personnes : des réflexes que je retrouve dans le support aux utilisateurs et la gestion de projet."
  >
    {
      SITE.cv && (
        <a href={url(SITE.cv)} download class="btn btn-primary mt-6">
          <Download class="size-4" aria-hidden="true" /> Télécharger mon CV (PDF)
        </a>
      )
    }
  </PageHeader>

  <div class="container-page py-10">
    <section aria-labelledby="recherche" class="card shadowed flex flex-col gap-4 sm:flex-row sm:items-center">
      <span class="tile"><Search class="size-6" aria-hidden="true" /></span>
      <div class="flex-1">
        <h2 id="recherche" class="font-bold">Je recherche</h2>
        <ul class="mt-1.5 flex flex-wrap gap-2">{SITE.recherche.map((r) => <li class="seek">{r}</li>)}</ul>
      </div>
      <a href={url('contact/')} class="btn btn-primary">Me contacter</a>
    </section>

    <div class="mt-12 grid gap-10 lg:grid-cols-2">
      {
        colonnes.map((col) => (
          <section aria-labelledby={col.id}>
            <h2 id={col.id} class="flex items-center gap-2.5 text-xl font-extrabold tracking-tight">
              <col.icone class="size-6 text-[var(--brand-2)]" aria-hidden="true" /> {col.titre}
            </h2>
            <ol class="mt-5 space-y-3.5">
              {col.etapes.map((e, i) => (
                <li class:list={['etape', (e.enCours || (col.id === 'experience' && i === 0)) && 'actuelle']}>
                  <span class="tile"><col.icone class="size-6" aria-hidden="true" /></span>
                  <div>
                    <p class="font-bold">
                      {e.titre}
                      {e.enCours && <span class="badge-encours">en cours</span>}
                    </p>
                    {(e.lieu || e.periode) && <p class="muted text-sm">{[e.lieu, e.periode].filter(Boolean).join(' · ')}</p>}
                    <p class="muted mt-1.5 text-[0.93rem]">{e.detail}</p>
                    {(e.fiche || e.rapport) && (
                      <div class="mt-3 flex flex-wrap gap-2">
                        {e.fiche && (
                          <a href={url(`realisations/${e.fiche}/`)} class="btn btn-ghost px-3 py-1.5 text-sm">
                            Fiche de réalisation <ArrowRight class="size-4" aria-hidden="true" />
                          </a>
                        )}
                        {e.rapport && (
                          <a href={url(e.rapport)} class="btn btn-ghost px-3 py-1.5 text-sm">
                            <FileText class="size-4" aria-hidden="true" /> Rapport de stage (PDF, version publique)
                          </a>
                        )}
                      </div>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>

    <section class="mt-14" aria-labelledby="certifications">
      <h2 id="certifications" class="text-xl font-extrabold tracking-tight">Certifications et entraînement</h2>
      <ul class="mt-5 grid gap-4 md:grid-cols-3">
        {
          ENTRAINEMENT.map((c) => {
            const I = ICONES_DIVERS[c.icone];
            return (
              <li class="card flex flex-col">
                <span class="tile"><I class="size-6" aria-hidden="true" /></span>
                <p class="mt-4 font-bold">{c.titre}</p>
                <p class="muted text-sm">{c.source}</p>
                <p class="mt-2 flex-1 text-[0.93rem]">{c.detail}</p>
                <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1.5">
                  {'fiche' in c && (
                    <a href={url(`realisations/${c.fiche}/`)} class="link inline-flex items-center gap-1 text-sm">Voir la fiche <ArrowRight class="size-4" aria-hidden="true" /></a>
                  )}
                  {'lien' in c && (
                    <a href={c.lien} rel="noopener" class="link inline-flex items-center gap-1 text-sm">Voir le profil <ExternalLink class="size-3.5" aria-hidden="true" /></a>
                  )}
                </div>
              </li>
            );
          })
        }
      </ul>
    </section>
  </div>
</BaseLayout>
