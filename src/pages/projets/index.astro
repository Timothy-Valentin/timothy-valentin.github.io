---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { formatDate, url } from '@/utils/url';

const projets = (await getCollection('projets', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);

// Couverture du référentiel : compétences SISR mobilisées par l'ensemble des projets.
const couverture = [...new Set(projets.flatMap((p) => p.data.competences))].sort();
---

<BaseLayout
  title="Réalisations professionnelles E4/E5"
  description="Fiches techniques détaillées des réalisations professionnelles présentées aux épreuves E4 et E5 du BTS SIO option SISR."
>
  <div class="container-page py-10">
    <PageHeader
      eyebrow="BTS SIO SISR · Épreuves E4 / E5"
      title="Réalisations professionnelles"
      intro="Chaque fiche présente une situation réellement vécue, en stage ou en atelier de formation : contexte, démarche, mise en œuvre et bilan. Les informations internes à l'organisation d'accueil ne sont pas publiées."
    />

    <div class="mt-10 space-y-6">
      {
        projets.map((p) => (
          <a href={url(`projets/${p.id}/`)} class="card card-link group block">
            <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-slate-500">
              <span class="badge badge-accent">{p.data.epreuve}</span>
              <span>{p.data.cadre}</span>
              <span aria-hidden="true">·</span>
              <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
            </div>
            <h2 class="mt-3 text-lg font-semibold text-slate-900 group-hover:text-brand-700 dark:text-slate-100 dark:group-hover:text-brand-300">
              {p.data.title}
            </h2>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{p.data.description}</p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {p.data.technologies.map((t) => (
                <li class="badge">{t}</li>
              ))}
            </ul>
          </a>
        ))
      }
    </div>

    <section class="mt-14" aria-labelledby="couverture">
      <h2 id="couverture" class="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-50">
        Couverture du référentiel SISR
      </h2>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
        Compétences du bloc 1 (support et mise à disposition de services) et du bloc 2 SISR
        (administration des systèmes et des réseaux) mobilisées dans les réalisations.
      </p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-[36rem] text-left text-sm">
          <thead class="font-mono text-xs text-slate-500 uppercase">
            <tr class="border-b border-slate-200 dark:border-slate-800">
              <th class="py-2 pr-4 font-normal">Compétence</th>
              {projets.map((p) => <th class="px-2 py-2 text-center font-normal">{p.data.epreuve}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              couverture.map((c) => (
                <tr class="border-b border-slate-100 dark:border-slate-900">
                  <td class="py-2 pr-4 text-slate-700 dark:text-slate-300">{c}</td>
                  {projets.map((p) => (
                    <td class="px-2 py-2 text-center font-mono text-brand-700 dark:text-brand-400">
                      {p.data.competences.includes(c) ? (
                        <span aria-label="couverte">■</span>
                      ) : (
                        <span class="text-slate-300 dark:text-slate-700" aria-label="non couverte">
                          □
                        </span>
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>
