---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { readingTime } from '@/utils/url';

export const getStaticPaths = (async () => {
  const entries = await getCollection('projets', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
---

<ArticleLayout
  title={d.title}
  description={d.description}
  date={d.date}
  eyebrow={`Réalisation professionnelle · ${d.epreuve}`}
  back={{ href: 'projets/', label: 'Toutes les réalisations' }}
  meta={[
    { label: 'Cadre', value: d.cadre },
    { label: 'Contexte', value: d.contexte },
    { label: 'Durée', value: d.duree },
    { label: 'Organisation', value: d.equipe },
    { label: 'Compétences SISR', value: d.competences.join(' · ') },
    { label: 'Technologies', value: d.technologies.join(', ') },
  ]}
  tags={d.motsCles}
  headings={headings}
  readingTime={readingTime(entry.body)}
  notice={d.confidentialite}
>
  <Content />
</ArticleLayout>
