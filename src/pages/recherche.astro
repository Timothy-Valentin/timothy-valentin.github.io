---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { url } from '@/utils/url';

const bundle = url('pagefind/');
---

<BaseLayout
  title="Recherche"
  description="Recherche plein texte dans le portfolio (projets, homelab, write-ups, veille)."
  noindex
>
  <div class="container-page max-w-3xl py-10">
    <PageHeader
      eyebrow="Recherche"
      title="Rechercher dans le portfolio"
      intro="Index plein texte généré au build par Pagefind : la recherche s'exécute entièrement dans votre navigateur, sans aucune requête vers un service tiers."
    />
    <link rel="stylesheet" href={`${bundle}pagefind-ui.css`} />
    <div id="search" class="mt-8" data-bundle={bundle}>
      <noscript>
        <p class="text-sm text-zinc-500">La recherche nécessite JavaScript.</p>
      </noscript>
    </div>
    <p id="search-unavailable" class="mt-8 hidden text-sm text-zinc-500">
      L'index de recherche n'est disponible qu'après un build de production
      (<code class="font-mono">npm run build &amp;&amp; npm run preview</code>).
    </p>
  </div>
</BaseLayout>

<script>
  const container = document.getElementById('search');
  const bundle = container?.dataset.bundle ?? '/pagefind/';

  type PagefindUIConstructor = new (options: Record<string, unknown>) => unknown;

  const script = document.createElement('script');
  script.src = `${bundle}pagefind-ui.js`;
  script.onload = () => {
    const PagefindUI = (window as unknown as { PagefindUI: PagefindUIConstructor }).PagefindUI;
    new PagefindUI({
      element: '#search',
      bundlePath: bundle,
      showSubResults: true,
      showImages: false,
      resetStyles: false,
      translations: {
        placeholder: 'Rechercher : VLAN, Proxmox, Zero Trust, Wireshark…',
        zero_results: 'Aucun résultat pour [SEARCH_TERM]',
      },
    });
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    const input = document.querySelector<HTMLInputElement>('#search input');
    if (input) {
      input.focus();
      if (q) {
        input.value = q;
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }
  };
  script.onerror = () => {
    document.getElementById('search-unavailable')?.classList.remove('hidden');
  };
  document.head.appendChild(script);
</script>
