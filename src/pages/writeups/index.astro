---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import EntryCard from '@/components/EntryCard.astro';
import { SITE } from '@/config/site';
import { byDateDesc, url } from '@/utils/url';

const writeups = (await getCollection('writeups', ({ data }) => !data.draft)).sort(byDateDesc);
---

<BaseLayout
  title="Pratique Root-Me"
  description="Pratique des fondamentaux réseau sur la plateforme Root-Me : méthodologie d'analyse de trames avec Wireshark et préconisations de sécurité."
>
  <div class="container-page py-10">
    <PageHeader
      eyebrow="Entraînement"
      title="Pratique Root-Me"
      intro="Root-Me est une plateforme française et légale d'entraînement à la sécurité informatique. J'y pratique les challenges de découverte réseau, qui complètent ma formation SISR. Ces fiches présentent la méthode suivie et les préconisations de sécurité qui en découlent."
    >
      <p class="mt-4 text-sm text-slate-500">
        Conformément aux règles de Root-Me, aucune solution ni aucun mot de passe de validation
        n'est publié.
        {
          SITE.rootme && (
            <>
              {' '}Profil :{' '}
              <a href={SITE.rootme.url} rel="noopener" class="text-brand-700 hover:underline dark:text-brand-300">
                root-me.org/{SITE.rootme.handle}
              </a>
              .
            </>
          )
        }
      </p>
    </PageHeader>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {
        writeups.map((w) => (
          <EntryCard
            href={url(`writeups/${w.id}/`)}
            title={w.data.title}
            description={w.data.description}
            date={w.data.date}
            label={w.data.categorie}
            tags={w.data.outils}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
