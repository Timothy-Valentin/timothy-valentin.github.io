---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import EntryCard from '@/components/EntryCard.astro';
import { SITE } from '@/config/site';
import { byDateDesc, url } from '@/utils/url';

const writeups = (await getCollection('writeups', ({ data }) => !data.draft)).sort(byDateDesc);
---

<BaseLayout
  title="Write-ups & entraînement cyber"
  description="Write-ups méthodologiques de challenges Root-Me orientés réseau : analyse de trames Wireshark, cartographie Nmap."
>
  <div class="container-page py-10">
    <PageHeader
      eyebrow="Entraînement cyber"
      title="Write-ups"
      intro="Je m'entraîne sur Root-Me, principalement dans les catégories Réseau et Forensic. Ces write-ups décrivent la méthodologie, les outils et surtout la remédiation côté défense — jamais les flags."
    >
      <p class="mt-4 text-sm text-zinc-500">
        Charte : conformément aux règles de Root-Me, aucune solution ni aucun mot de passe de
        validation n'est publié. Profil :{' '}
        <a href={SITE.rootme.url} rel="noopener" class="text-cyan-700 hover:underline dark:text-cyan-400"
          >root-me.org/{SITE.rootme.handle}</a
        >.
      </p>
    </PageHeader>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {
        writeups.map((w) => (
          <EntryCard
            href={url(`writeups/${w.id}/`)}
            title={w.data.title}
            description={w.data.description}
            date={w.data.date}
            label={`${w.data.categorie} · ${w.data.difficulte}`}
            tags={w.data.outils}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
