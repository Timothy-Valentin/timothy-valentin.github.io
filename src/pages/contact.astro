---
import { ArrowRight, Flag, Mail, ShieldCheck, Target } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import BrandIcon from '@/components/BrandIcon.astro';
import { SITE } from '@/config/site';
import { url } from '@/utils/url';

type Canal = {
  label: string;
  value: string;
  href: string;
  hint: string;
  icon: 'github' | 'linkedin' | 'rootme' | 'tryhackme';
};

const canaux: Canal[] = [
  ...(SITE.linkedin
    ? [{ label: 'LinkedIn', value: `linkedin.com/in/${SITE.linkedin.handle}`, href: SITE.linkedin.url, hint: 'Parcours professionnel.', icon: 'linkedin' as const }]
    : []),
  { label: 'GitHub', value: `github.com/${SITE.github.handle}`, href: SITE.github.url, hint: 'Code source de ce portfolio.', icon: 'github' },
  { label: 'Root-Me', value: `root-me.org/${SITE.rootme.handle}`, href: SITE.rootme.url, hint: 'Profil d’entraînement à la cybersécurité.', icon: 'rootme' },
  { label: 'TryHackMe', value: `tryhackme.com/p/${SITE.tryhackme.handle}`, href: SITE.tryhackme.url, hint: 'Parcours d’apprentissage en cybersécurité défensive.', icon: 'tryhackme' },
];
---

<BaseLayout
  title="Contact"
  description="Contacter Timothy Valentin, étudiant en BTS SIO SISR à la recherche d'un stage de 2e année et d'une alternance en cybersécurité."
>
  <PageHeader
    eyebrow="Contact"
    title="Me contacter"
    intro="Pour une proposition de stage, d'alternance ou un échange sur mon parcours, le plus simple est de m'écrire par e-mail."
  />

  <div class="container-page py-10">
    <a href={`mailto:${SITE.email}`} class="card panel-brand card-link flex flex-col gap-5 p-7 sm:flex-row sm:items-center">
      <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-white/15"><Mail class="size-7" aria-hidden="true" /></span>
      <span class="min-w-0 flex-1">
        <span class="block text-sm font-semibold tracking-wide uppercase opacity-80">E-mail</span>
        <span class="mt-0.5 block truncate text-xl font-bold sm:text-2xl">{SITE.email}</span>
        <span class="muted block">Pour une proposition de stage ou d'alternance.</span>
      </span>
      <span class="btn btn-ghost shrink-0">M'écrire <ArrowRight class="size-4" aria-hidden="true" /></span>
    </a>

    <ul class="mt-4.5 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        canaux.map((c) => (
          <li class="min-w-0">
            <a href={c.href} rel="me noopener" class="card card-link flex h-full min-w-0 items-center gap-4">
              <span class="tile">
                {c.icon === 'rootme' && <Flag class="size-6" aria-hidden="true" />}
                {c.icon === 'tryhackme' && <Target class="size-6" aria-hidden="true" />}
                {(c.icon === 'github' || c.icon === 'linkedin') && <BrandIcon name={c.icon} class="size-6" />}
              </span>
              <span class="min-w-0">
                <span class="muted block text-xs font-semibold uppercase">{c.label}</span>
                <span class="block truncate font-semibold">{c.value}</span>
                <span class="muted block text-sm">{c.hint}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="notice mt-8 flex items-center gap-2.5">
      <ShieldCheck class="size-4 shrink-0" aria-hidden="true" />
      <span>
        Signalement d'un problème de sécurité sur ce site :{' '}
        <a href={url('.well-known/security.txt')} class="link font-mono">security.txt</a>{' '}(RFC 9116).
      </span>
    </p>
  </div>
</BaseLayout>
