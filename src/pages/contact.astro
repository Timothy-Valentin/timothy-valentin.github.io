---
import { Mail, ShieldCheck } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import BrandIcon from '@/components/BrandIcon.astro';
import { SITE } from '@/config/site';
import { url } from '@/utils/url';

type Canal = {
  label: string;
  value: string;
  href: string;
  hint: string;
  icon: 'mail' | 'github' | 'linkedin';
};

const canaux: Canal[] = [
  {
    label: 'E-mail',
    value: SITE.email,
    href: `mailto:${SITE.email}`,
    hint: 'Canal privilégié pour toute proposition d’alternance.',
    icon: 'mail',
  },
  {
    label: 'GitHub',
    value: `github.com/${SITE.github.handle}`,
    href: SITE.github.url,
    hint: 'Code source de ce portfolio.',
    icon: 'github',
  },
];
if (SITE.linkedin) {
  canaux.push({
    label: 'LinkedIn',
    value: `linkedin.com/in/${SITE.linkedin.handle}`,
    href: SITE.linkedin.url,
    hint: 'Parcours et recherche d’alternance.',
    icon: 'linkedin',
  });
}
---

<BaseLayout
  title="Contact"
  description="Contacter Timothy Valentin, étudiant en BTS SIO SISR à la recherche d'une alternance en cybersécurité."
>
  <div class="container-page max-w-3xl py-10">
    <PageHeader
      eyebrow="Contact"
      title="Me contacter"
      intro="Pour une proposition d'alternance ou un échange sur mon parcours, le plus simple est de m'écrire par e-mail."
    />

    <ul class="mt-10 divide-y divide-slate-200 border-y border-slate-200 dark:divide-slate-800 dark:border-slate-800">
      {
        canaux.map((c) => (
          <li>
            <a
              href={c.href}
              rel={c.icon === 'mail' ? undefined : 'me noopener'}
              class="group flex items-center gap-4 py-4"
            >
              <span class="flex size-10 shrink-0 items-center justify-center rounded-md border border-slate-200 text-brand-700 dark:border-slate-800 dark:text-brand-300">
                {c.icon === 'mail' ? <Mail class="size-4" aria-hidden="true" /> : <BrandIcon name={c.icon} />}
              </span>
              <span class="min-w-0">
                <span class="block text-xs text-slate-500 uppercase">{c.label}</span>
                <span class="block truncate font-medium text-slate-900 group-hover:text-brand-700 dark:text-slate-100 dark:group-hover:text-brand-300">
                  {c.value}
                </span>
                <span class="block text-sm text-slate-500">{c.hint}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <section class="mt-10 card" aria-labelledby="divulgation">
      <h2 id="divulgation" class="flex items-center gap-2 font-semibold text-slate-900 dark:text-slate-100">
        <ShieldCheck class="size-4 text-brand-700 dark:text-brand-300" aria-hidden="true" />
        Signalement de sécurité
      </h2>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
        Ce site est statique (aucune base de données, aucun cookie, aucun script tiers). Pour
        signaler un problème de sécurité, les modalités sont publiées dans le fichier{' '}
        <a href={url('.well-known/security.txt')} class="font-mono text-brand-700 hover:underline dark:text-brand-300"
          >/.well-known/security.txt</a
        >{' '}(RFC 9116).
      </p>
    </section>
  </div>
</BaseLayout>
