---
import { Flag, Mail, Target } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import BrandIcon from '@/components/BrandIcon.astro';
import { SITE } from '@/config/site';
import { url } from '@/utils/url';

type Canal = {
  label: string;
  value: string;
  href: string;
  hint: string;
  icon: 'mail' | 'github' | 'linkedin' | 'rootme' | 'tryhackme';
};

const canaux: Canal[] = [
  {
    label: 'E-mail',
    value: SITE.email,
    href: `mailto:${SITE.email}`,
    hint: 'Pour une proposition de stage ou d’alternance.',
    icon: 'mail',
  },
  ...(SITE.linkedin
    ? [
        {
          label: 'LinkedIn',
          value: `linkedin.com/in/${SITE.linkedin.handle}`,
          href: SITE.linkedin.url,
          hint: 'Parcours professionnel.',
          icon: 'linkedin' as const,
        },
      ]
    : []),
  {
    label: 'GitHub',
    value: `github.com/${SITE.github.handle}`,
    href: SITE.github.url,
    hint: 'Code source de ce portfolio.',
    icon: 'github',
  },
  {
    label: 'Root-Me',
    value: `root-me.org/${SITE.rootme.handle}`,
    href: SITE.rootme.url,
    hint: 'Profil d’entraînement à la cybersécurité.',
    icon: 'rootme',
  },
  {
    label: 'TryHackMe',
    value: `tryhackme.com/p/${SITE.tryhackme.handle}`,
    href: SITE.tryhackme.url,
    hint: 'Parcours d’apprentissage en cybersécurité défensive.',
    icon: 'tryhackme',
  },
];
---

<BaseLayout
  title="Contact"
  description="Contacter Timothy Valentin, étudiant en BTS SIO SISR à la recherche d'un stage de 2e année et d'une alternance en cybersécurité."
>
  <div class="container-page max-w-3xl py-10">
    <PageHeader
      eyebrow="Contact"
      title="Me contacter"
      intro="Pour une proposition de stage, d'alternance ou un échange sur mon parcours, le plus simple est de m'écrire par e-mail."
    />

    <ul class="mt-10 divide-y divide-slate-200 border-y border-slate-200 dark:divide-slate-800 dark:border-slate-800">
      {
        canaux.map((c) => (
          <li>
            <a href={c.href} rel={c.icon === 'mail' ? undefined : 'me noopener'} class="group flex items-center gap-4 py-4">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-md border border-slate-200 text-brand-700 dark:border-slate-800 dark:text-brand-300">
                {c.icon === 'mail' && <Mail class="size-4" aria-hidden="true" />}
                {c.icon === 'rootme' && <Flag class="size-4" aria-hidden="true" />}
                {c.icon === 'tryhackme' && <Target class="size-4" aria-hidden="true" />}
                {(c.icon === 'github' || c.icon === 'linkedin') && <BrandIcon name={c.icon} />}
              </span>
              <span class="min-w-0">
                <span class="block text-xs text-slate-500 uppercase">{c.label}</span>
                <span class="block truncate font-medium text-slate-900 group-hover:text-brand-700 dark:text-slate-100 dark:group-hover:text-brand-300">
                  {c.value}
                </span>
                <span class="block text-sm text-slate-500">{c.hint}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 text-sm text-slate-500">
      Signalement d'un problème de sécurité sur ce site :{' '}
      <a href={url('.well-known/security.txt')} class="link font-mono">security.txt</a>{' '}(RFC 9116).
    </p>
  </div>
</BaseLayout>
