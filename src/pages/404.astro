---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { url } from '@/utils/url';
---

<BaseLayout title="Page introuvable" noindex>
  <div class="container-page py-24">
    <pre
      class="font-mono text-sm text-zinc-500">$ curl -I {Astro.url.pathname}
<span class="text-cyan-700 dark:text-cyan-400">HTTP/2 404</span>
content-type: text/html; charset=utf-8</pre>
    <h1 class="mt-6 text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
      Cette route n'existe pas.
    </h1>
    <p class="mt-3 text-zinc-600 dark:text-zinc-400">
      Le paquet s'est perdu en chemin. Retour à la table de routage :
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={url()} class="btn btn-primary">Accueil</a>
      <a href={url('recherche/')} class="btn btn-ghost">Rechercher</a>
    </div>
  </div>
</BaseLayout>
