---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { url } from '@/utils/url';
---

<BaseLayout title="Page introuvable">
  <section class="hero">
    <div class="container-page py-24 text-center">
      <p class="eyebrow">Erreur 404</p>
      <h1 class="h1 mt-3">Page introuvable</h1>
      <p class="lead mx-auto mt-4 max-w-xl">La page demandée n'existe pas ou a été déplacée.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-2.5">
        <a href={url()} class="btn btn-primary">Retour à l'accueil</a>
        <a href={url('realisations/')} class="btn btn-ghost">Voir les réalisations</a>
      </div>
    </div>
  </section>
</BaseLayout>
