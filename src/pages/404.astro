---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { url } from '@/utils/url';
---

<BaseLayout title="Page introuvable" noindex>
  <div class="container-page py-24">
    <p class="eyebrow">Erreur 404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50">
      Page introuvable
    </h1>
    <p class="mt-3 text-slate-600 dark:text-slate-400">
      La page demandée n'existe pas ou a été déplacée.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={url()} class="btn btn-primary">Retour à l'accueil</a>
      <a href={url('recherche/')} class="btn btn-ghost">Rechercher</a>
    </div>
  </div>
</BaseLayout>
