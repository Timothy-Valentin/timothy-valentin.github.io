---
import { getCollection } from 'astro:content';
import { ArrowRight, BookOpen, Download, Mail, Network, Server, ShieldCheck, TableProperties } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import EntryCard from '@/components/EntryCard.astro';
import BrandIcon from '@/components/BrandIcon.astro';
import { SITE } from '@/config/site';
import { CONTEXTES } from '@/config/referentiel';
import { url } from '@/utils/url';

const realisations = (await getCollection('realisations', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);

const blocs = [
  {
    icon: Network,
    titre: 'Réseau',
    items: [
      'VLAN 802.1Q et routage inter-VLAN',
      'DHCP : étendues, exclusions, relais',
      'Pare-feu pfSense',
      'Cisco Packet Tracer au quotidien',
      'Configuration en console avec PuTTY',
      'Diagnostic de pannes par couches OSI',
    ],
  },
  {
    icon: Server,
    titre: 'Systèmes & virtualisation',
    items: [
      'Proxmox VE au quotidien, VirtualBox',
      'Windows Server : AD DS, DNS, DHCP, GPO',
      'Clients Windows et Ubuntu',
      'Mise en place de sauvegardes',
      'Linux : Debian, Ubuntu, Kali',
      'Remise en service de serveurs',
    ],
  },
  {
    icon: ShieldCheck,
    titre: 'Cybersécurité',
    items: [
      'Badge Cisco « Introduction to Cybersecurity »',
      'Root-Me : 8 challenges Réseau validés',
      'Analyse de trames avec Wireshark',
      'Protocoles chiffrés (SSH, HTTPS, SFTP)',
      'Sécurisation des sessions par GPO',
      'Veille : les passkeys (FIDO2)',
    ],
  },
];
---

<BaseLayout>
  <!-- Présentation -->
  <section class="border-b border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900/40">
    <div class="container-page py-14 sm:py-20">
      <p class="eyebrow">{SITE.role}</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-50">
        {SITE.author}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-slate-700 dark:text-slate-300">
        En reconversion après une première carrière dans les métiers de la forme, je me forme à
        l'administration des systèmes et des réseaux au lycée Henri Matisse de Cugnaux, et je
        m'oriente vers la cybersécurité.
      </p>

      <div class="mt-6 max-w-2xl rounded-lg border border-brand-200 bg-white p-4 dark:border-brand-400/30 dark:bg-slate-900">
        <p class="text-sm font-semibold text-brand-800 dark:text-brand-300">Je recherche</p>
        <ul class="mt-1 list-disc space-y-0.5 pl-5 text-sm text-slate-700 dark:text-slate-300">
          {SITE.recherche.map((r) => <li>{r}</li>)}
        </ul>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={url('realisations/')} class="btn btn-primary">
          Mes réalisations <ArrowRight class="size-4" aria-hidden="true" />
        </a>
        <a href={url('competences/')} class="btn btn-ghost">
          <TableProperties class="size-4" aria-hidden="true" /> Tableau des compétences
        </a>
        {
          SITE.cv && (
            <a href={url(SITE.cv)} download class="btn btn-ghost">
              <Download class="size-4" aria-hidden="true" /> CV
            </a>
          )
        }
        <a href={url('contact/')} class="btn btn-ghost">
          <Mail class="size-4" aria-hidden="true" /> Contact
        </a>
        <a href={SITE.github.url} rel="me noopener" class="btn btn-ghost">
          <BrandIcon name="github" /> GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- Compétences -->
  <section class="container-page py-14" aria-labelledby="competences">
    <p class="eyebrow">Compétences</p>
    <h2 id="competences" class="h2 mt-2">Ce que je sais faire</h2>
    <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-400">
      Uniquement des compétences pratiquées en stage, en formation ou en autonomie, et démontrées
      dans les fiches de réalisation.
    </p>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {
        blocs.map((bloc) => (
          <div class="card">
            <h3 class="flex items-center gap-2 font-semibold text-slate-900 dark:text-slate-100">
              <bloc.icon class="size-5 text-brand-700 dark:text-brand-300" aria-hidden="true" />
              {bloc.titre}
            </h3>
            <ul class="mt-4 space-y-2 text-sm text-slate-700 dark:text-slate-400">
              {bloc.items.map((item) => (
                <li class="flex gap-2">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-brand-700 dark:bg-brand-300" aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Réalisations -->
  <section class="container-page py-4" aria-labelledby="realisations">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Réalisations</p>
        <h2 id="realisations" class="h2 mt-2">Stage, formation et projets personnels</h2>
      </div>
      <a href={url('realisations/')} class="link shrink-0 text-sm">Tout voir →</a>
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {
        realisations.slice(0, 4).map((r) => (
          <EntryCard
            href={url(`realisations/${r.id}/`)}
            title={r.data.title}
            description={r.data.description}
            label={CONTEXTES[r.data.contexte]}
            meta={r.data.periode}
            tags={r.data.outils}
          />
        ))
      }
    </div>
  </section>

  <!-- Accès rapides -->
  <section class="container-page py-10" aria-label="Accès rapides">
    <div class="grid gap-4 sm:grid-cols-2">
      <a href={url('competences/')} class="card card-link">
        <TableProperties class="size-5 text-brand-700 dark:text-brand-300" aria-hidden="true" />
        <h3 class="mt-3 font-semibold text-slate-900 dark:text-slate-100">Tableau de synthèse</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
          Chaque compétence du référentiel BTS SIO reliée aux réalisations qui la démontrent.
        </p>
      </a>
      <a href={url('veille/')} class="card card-link">
        <BookOpen class="size-5 text-brand-700 dark:text-brand-300" aria-hidden="true" />
        <h3 class="mt-3 font-semibold text-slate-900 dark:text-slate-100">Veille technologique</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
          Les passkeys : vers la fin des mots de passe ?
        </p>
      </a>
    </div>
  </section>
</BaseLayout>
