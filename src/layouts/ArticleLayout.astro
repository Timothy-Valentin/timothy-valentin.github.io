---
import type { MarkdownHeading } from 'astro';
import { ArrowLeft } from '@lucide/astro';
import BaseLayout from './BaseLayout.astro';
import { url } from '@/utils/url';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  back: { href: string; label: string };
  meta?: { label: string; value: string }[];
  headings?: MarkdownHeading[];
  notice?: string;
}

const { title, description, eyebrow, back, meta = [], headings = [], notice } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={title} description={description} type="article">
  <article class="container-page py-10">
    <a href={url(back.href)} class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-brand-700 dark:hover:text-brand-300">
      <ArrowLeft class="size-4" aria-hidden="true" />
      {back.label}
    </a>

    <header class="mt-6 border-b border-slate-200 pb-8 dark:border-slate-800">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-2 text-2xl leading-tight font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-slate-50">
        {title}
      </h1>
      <p class="mt-3 max-w-3xl text-slate-600 dark:text-slate-400">{description}</p>

      {
        meta.length > 0 && (
          <dl class="mt-6 grid gap-x-8 gap-y-3 text-sm sm:grid-cols-2">
            {meta.map((m) => (
              <div>
                <dt class="text-xs text-slate-500 uppercase">{m.label}</dt>
                <dd class="mt-0.5 text-slate-800 dark:text-slate-200">{m.value}</dd>
              </div>
            ))}
          </dl>
        )
      }

      <slot name="entete" />

      {
        notice && (
          <p class="mt-6 rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300">
            {notice}
          </p>
        )
      }
    </header>

    <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_13rem]">
      <div class="prose-tech min-w-0">
        <slot />
      </div>
      {
        toc.length > 2 && (
          <aside class="hidden lg:block">
            <nav aria-label="Sommaire" class="sticky top-20">
              <p class="eyebrow mb-3">Sommaire</p>
              <ol class="space-y-2 border-l border-slate-200 text-sm dark:border-slate-800">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class="-ml-px block border-l border-transparent pl-3 text-slate-500 hover:border-brand-500 hover:text-brand-700 dark:hover:text-brand-300"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>
