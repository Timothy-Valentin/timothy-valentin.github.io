---
/** Mise en page des fiches de veille : en-tête, informations clés et sommaire latéral. */
import type { MarkdownHeading } from 'astro';
import { ChevronRight } from '@lucide/astro';
import BaseLayout from './BaseLayout.astro';
import { url } from '@/utils/url';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  back: { href: string; label: string };
  meta?: { label: string; value: string }[];
  headings?: MarkdownHeading[];
  notice?: string;
}

const { title, description, eyebrow, back, meta = [], headings = [], notice } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={title} description={description} type="article">
  <header class="hero">
    <div class="container-page py-10 md:py-14">
      <nav aria-label="Fil d'Ariane" class="muted flex items-center gap-1.5 text-sm">
        <a href={url(back.href)} class="hover:text-[var(--brand-2)]">{back.label}</a>
        <ChevronRight class="size-3.5" aria-hidden="true" />
        <span aria-current="page">{eyebrow}</span>
      </nav>
      <h1 class="mt-5 max-w-4xl text-[clamp(1.6rem,3.6vw,2.4rem)] leading-tight font-extrabold tracking-tight">{title}</h1>
      <p class="lead mt-3 max-w-3xl">{description}</p>
    </div>
  </header>

  <div class="container-page grid gap-8 py-10 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <aside class="space-y-4 lg:order-2">
      {
        meta.length > 0 && (
          <dl class="card space-y-3 text-[0.93rem]">
            {meta.map((m) => (
              <div>
                <dt class="muted text-xs font-semibold uppercase">{m.label}</dt>
                <dd>{m.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {
        toc.length > 2 && (
          <nav aria-label="Sommaire" class="card hidden lg:sticky lg:top-24 lg:block">
            <p class="text-sm font-bold tracking-wide text-[var(--brand-2)] uppercase">Sommaire</p>
            <ol class="mt-3 space-y-1.5 border-l-2 border-[var(--line)] text-[0.9rem]">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="muted -ml-0.5 block border-l-2 border-transparent pl-3 hover:border-[var(--brand-2)] hover:text-[var(--brand-2)]">
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </aside>

    <div class="min-w-0 lg:order-1">
      {notice && <p class="notice mb-8">{notice}</p>}
      <article class="prose-tech">
        <slot />
      </article>
    </div>
  </div>
</BaseLayout>
