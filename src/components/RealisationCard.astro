---
import type { CollectionEntry } from 'astro:content';
import { ArrowRight } from '@lucide/astro';
import { CONTEXTES } from '@/config/referentiel';
import { TEINTE, iconeFiche } from '@/config/visuels';
import { url } from '@/utils/url';

interface Props {
  r: CollectionEntry<'realisations'>;
}

const { r } = Astro.props;
const Icone = iconeFiche(r.id);
---

<a
  href={url(`realisations/${r.id}/`)}
  class:list={['card card-link flex h-full flex-col', TEINTE[r.data.contexte]]}
  data-contexte={r.data.contexte}
>
  <div class="flex items-center justify-between gap-3">
    <span class="tile"><Icone class="size-6" aria-hidden="true" /></span>
    <span class="tag">{CONTEXTES[r.data.contexte]}</span>
  </div>
  <h3 class="mt-4 text-lg leading-snug font-bold">{r.data.title}</h3>
  <p class="muted mt-1.5 line-clamp-3 flex-1 text-[0.93rem] leading-relaxed">{r.data.description}</p>
  <p class="mt-3 text-xs font-semibold text-[var(--muted)]">{r.data.periode}</p>
  <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Outils">
    {r.data.outils.slice(0, 4).map((o) => <li class="chip-tool">{o}</li>)}
  </ul>
  <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--brand-2)]">
    Voir la fiche <ArrowRight class="size-4" aria-hidden="true" />
  </span>
</a>
