---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<header class="border-b border-zinc-200 pb-8 dark:border-zinc-800">
  <p class="eyebrow">{eyebrow}</p>
  <h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">{title}</h1>
  <p class="mt-3 max-w-3xl text-zinc-600 dark:text-zinc-400">{intro}</p>
  <slot />
</header>
