---
/** En-tête des pages intérieures : bandeau léger avec surtitre, titre et introduction. */
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<header class="hero">
  <div class="container-page py-12 md:py-16">
    <slot name="avant" />
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="h1 mt-2.5 max-w-4xl">{title}</h1>
    {intro && <p class="lead mt-4 max-w-3xl">{intro}</p>}
    <slot />
  </div>
</header>
