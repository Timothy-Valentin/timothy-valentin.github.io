---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<header class="border-b border-slate-200 pb-8 dark:border-slate-800">
  <p class="eyebrow">{eyebrow}</p>
  <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50">{title}</h1>
  <p class="mt-3 max-w-3xl text-slate-600 dark:text-slate-400">{intro}</p>
  <slot />
</header>
