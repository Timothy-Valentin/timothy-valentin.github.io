---
import { Menu } from '@lucide/astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV, SITE } from '@/config/site';
import { url } from '@/utils/url';

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const target = url(href).replace(/\/+$/, '') || '/';
  return href === '' ? current === target : current.startsWith(target);
};
---

<header
  class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90"
>
  <div class="container-page flex h-14 items-center justify-between gap-4">
    <a href={url()} class="flex flex-col leading-tight">
      <span class="text-sm font-semibold text-brand-800 dark:text-slate-100">{SITE.author}</span>
      <span class="text-xs text-slate-500 dark:text-slate-400">BTS SIO — option SISR</span>
    </a>

    <nav aria-label="Navigation principale" class="hidden md:block">
      <ul class="flex items-center gap-1 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded px-2.5 py-1.5 transition-colors hover:text-brand-700 dark:hover:text-brand-300',
                  isActive(item.href)
                    ? 'font-medium text-brand-700 dark:text-brand-300'
                    : 'text-slate-600 dark:text-slate-400',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <ThemeToggle />
      <details class="relative md:hidden">
        <summary
          class="list-none rounded p-2 text-slate-600 hover:text-brand-700 dark:text-slate-400 [&::-webkit-details-marker]:hidden"
          aria-label="Ouvrir le menu"
        >
          <Menu class="size-5" aria-hidden="true" />
        </summary>
        <nav
          aria-label="Navigation mobile"
          class="absolute right-0 mt-2 w-52 rounded-lg border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-800 dark:bg-slate-900"
        >
          <ul class="flex flex-col text-sm">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={url(item.href)}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class:list={[
                      'block rounded px-3 py-2 hover:bg-slate-100 dark:hover:bg-slate-800',
                      isActive(item.href) && 'font-medium text-brand-700 dark:text-brand-300',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
