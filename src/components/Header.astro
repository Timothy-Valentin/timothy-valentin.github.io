---
import { Mail, Menu } from '@lucide/astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV, SITE } from '@/config/site';
import { url } from '@/utils/url';

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => current.startsWith(url(href).replace(/\/+$/, ''));
---

<header class="sticky top-0 z-40 border-b border-[var(--line)] bg-[var(--bg)]/90 backdrop-blur">
  <div class="container-page flex h-16 items-center gap-4">
    <a href={url()} class="flex items-center gap-2.5 font-bold" aria-label={`${SITE.author} — accueil`}>
      <span class="grid size-9 place-items-center rounded-[0.65rem] bg-[var(--brand)] text-[0.8rem] tracking-wide text-[var(--on-brand)]">TV</span>
      <span class="leading-tight">
        {SITE.author}
        <span class="block text-xs font-normal text-[var(--muted)]">BTS SIO — option SISR</span>
      </span>
    </a>

    <nav aria-label="Navigation principale" class="ml-auto hidden md:block">
      <ul class="flex items-center gap-1 text-[0.93rem]">
        {
          NAV.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-lg px-3 py-2 transition-colors hover:bg-[var(--bg-soft)] hover:text-[var(--text)]',
                  isActive(item.href) ? 'font-semibold text-[var(--brand-2)]' : 'text-[var(--muted)]',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2 md:ml-0">
      <ThemeToggle />
      <a href={url('contact/')} class="btn btn-primary hidden sm:inline-flex">
        <Mail class="size-4" aria-hidden="true" /> Me contacter
      </a>
      <details class="relative md:hidden">
        <summary class="icon-btn list-none [&::-webkit-details-marker]:hidden" aria-label="Ouvrir le menu">
          <Menu class="size-5" aria-hidden="true" />
        </summary>
        <nav
          aria-label="Navigation mobile"
          class="absolute right-0 mt-2 w-56 rounded-xl border border-[var(--line)] bg-[var(--card)] p-2 shadow-lg"
        >
          <ul class="flex flex-col text-[0.95rem]">
            <li><a href={url()} class="block rounded-lg px-3 py-2 hover:bg-[var(--bg-soft)]">Accueil</a></li>
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={url(item.href)}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class:list={[
                      'block rounded-lg px-3 py-2 hover:bg-[var(--bg-soft)]',
                      isActive(item.href) && 'font-semibold text-[var(--brand-2)]',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li><a href={url('contact/')} class="block rounded-lg px-3 py-2 hover:bg-[var(--bg-soft)]">Contact</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
