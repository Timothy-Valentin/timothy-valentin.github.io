---
import { Menu, Search, Terminal } from '@lucide/astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV, SITE } from '@/config/site';
import { url } from '@/utils/url';

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const target = url(href).replace(/\/+$/, '') || '/';
  return href === '' ? current === target : current.startsWith(target);
};
---

<header
  class="sticky top-0 z-40 border-b border-zinc-200 bg-zinc-50/90 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/85"
>
  <div class="container-page flex h-14 items-center justify-between gap-4">
    <a
      href={url()}
      class="flex items-center gap-2 font-mono text-sm font-bold text-zinc-900 dark:text-zinc-100"
    >
      <Terminal class="size-4 text-cyan-600 dark:text-cyan-400" aria-hidden="true" />
      <span>{SITE.shortTitle}</span>
    </a>

    <nav aria-label="Navigation principale" class="hidden md:block">
      <ul class="flex items-center gap-1 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded px-2.5 py-1.5 transition-colors hover:text-cyan-700 dark:hover:text-cyan-300',
                  isActive(item.href)
                    ? 'text-cyan-700 dark:text-cyan-400'
                    : 'text-zinc-600 dark:text-zinc-400',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a
        href={url('recherche/')}
        class="rounded p-2 text-zinc-600 hover:text-cyan-700 dark:text-zinc-400 dark:hover:text-cyan-300"
        aria-label="Rechercher dans le portfolio"
        title="Rechercher"
      >
        <Search class="size-4" aria-hidden="true" />
      </a>
      <ThemeToggle />
      <details class="group relative md:hidden">
        <summary
          class="list-none rounded p-2 text-zinc-600 hover:text-cyan-700 dark:text-zinc-400 [&::-webkit-details-marker]:hidden"
          aria-label="Ouvrir le menu"
        >
          <Menu class="size-5" aria-hidden="true" />
        </summary>
        <nav
          aria-label="Navigation mobile"
          class="absolute right-0 mt-2 w-52 rounded-lg border border-zinc-200 bg-white p-2 shadow-lg dark:border-zinc-800 dark:bg-zinc-900"
        >
          <ul class="flex flex-col text-sm">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={url(item.href)}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class:list={[
                      'block rounded px-3 py-2 hover:bg-zinc-100 dark:hover:bg-zinc-800',
                      isActive(item.href) && 'text-cyan-700 dark:text-cyan-400',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
