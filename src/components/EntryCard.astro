---
import { ArrowRight } from '@lucide/astro';

interface Props {
  href: string;
  title: string;
  description: string;
  label: string;
  meta?: string;
  tags?: readonly string[];
}

const { href, title, description, label, meta, tags = [] } = Astro.props;
---

<a href={href} class="card card-link group flex h-full flex-col">
  <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500">
    <span class="badge badge-accent">{label}</span>
    {meta && <span>{meta}</span>}
  </div>
  <h3 class="mt-3 font-semibold text-slate-900 group-hover:text-brand-700 dark:text-slate-100 dark:group-hover:text-brand-300">
    {title}
  </h3>
  <p class="mt-2 flex-1 text-sm text-slate-600 dark:text-slate-400">{description}</p>
  {
    tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {tags.slice(0, 4).map((t) => (
          <li class="badge">{t}</li>
        ))}
      </ul>
    )
  }
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-700 dark:text-brand-300">
    Voir la fiche <ArrowRight class="size-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
  </span>
</a>
