---
import { Moon, Sun } from '@lucide/astro';
---

<button type="button" id="theme-toggle" class="icon-btn" aria-label="Basculer entre thème sombre et clair" title="Thème sombre / clair">
  <Sun class="hidden size-[1.1rem] dark:block" aria-hidden="true" />
  <Moon class="block size-[1.1rem] dark:hidden" aria-hidden="true" />
</button>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch (_) {
      /* stockage indisponible : le choix vaut pour la page courante */
    }
  });
</script>
