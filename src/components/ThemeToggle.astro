---
import { Moon, Sun } from '@lucide/astro';
---

<button
  type="button"
  id="theme-toggle"
  class="rounded p-2 text-zinc-600 hover:text-cyan-700 dark:text-zinc-400 dark:hover:text-cyan-300"
  aria-label="Basculer entre thème sombre et clair"
  title="Thème sombre / clair"
>
  <Sun class="hidden size-4 dark:block" aria-hidden="true" />
  <Moon class="block size-4 dark:hidden" aria-hidden="true" />
</button>

<script>
  const button = document.getElementById('theme-toggle');
  button?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch (_) {
      /* stockage indisponible : le choix vaut pour la page courante */
    }
    document.dispatchEvent(new CustomEvent('themechange'));
  });
</script>
